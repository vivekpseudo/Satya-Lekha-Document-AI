# ---- Image and port (docker-compose.yml) ----------------------------------------
# The image your registry holds. Build and push it with docker-compose.build.yml, then deploy this tag.
# Prefer a version tag over "latest" so you can roll back.
APP_IMAGE=registry.example.com/satya-lekha-app:1.0.0
# Where the API is published on the host. Loopback by default: reach it through a reverse proxy.
# APP_PORT_BIND=127.0.0.1:8000     # use 127.0.0.1:18000 if 8000 is taken, 0.0.0.0:8000 to publish publicly
# APP_PLATFORM=linux/amd64         # build machine only: CPU architecture of the server

# ---- Extraction and embeddings -------------------------------------------------
# local  = runs inside the app, no Google account (PDF text only; embeddings via fastembed)
# google = Document AI / Vertex AI (also reads scans and images)
EXTRACTOR=local
EMBEDDER=local

# Embedding model and its vector size. Changing them means reloading the regulation passages.
# For EMBEDDER=google use gemini-embedding-001 with 768.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
# FASTEMBED_CACHE_PATH=/opt/fastembed     # where the local model is cached (baked into the Docker image)

# ---- Database -------------------------------------------------------------------
# Local development: the container from docker-compose.postgres.yml.
# Docker deployment: use the database container's name as the host.
DATABASE_URL=postgresql+psycopg://satya:satya@localhost:5432/satya_lekha

# ---- API ------------------------------------------------------------------------
MAX_UPLOAD_MB=20
# Origins allowed to call the API from a browser (only needed for the Vite dev server)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Google (only when EXTRACTOR=google or EMBEDDER=google) ---------------------
# Document AI needs a service-account key (or Application Default Credentials), not an API key.
# Never commit the key. Point GOOGLE_APPLICATION_CREDENTIALS at it, or mount it in Docker.
GOOGLE_CLOUD_PROJECT=
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ---- Docker Compose only --------------------------------------------------------
# docker-compose.yml joins these two EXISTING Docker networks: the database's and the reverse proxy's.
# The database host in DATABASE_URL must be reachable on POSTGRES_NETWORK (use the container's name).
POSTGRES_NETWORK=postgres_default
PROXY_NETWORK=proxy
